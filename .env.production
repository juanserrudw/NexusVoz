# Base de datos (Railway generará automáticamente)
DATABASE_URL=${{Postgres.DATABASE_URL}}
POSTGRES_DB=nexusvoz
POSTGRES_USER=nexusvoz
POSTGRES_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}

# Variables de autenticación
SECRET_KEY=${{SECRET_KEY}}
AUTH_API_KEY=${{AUTH_API_KEY}}

# APIs externas
RETELL_API_KEY=${{RETELL_API_KEY}}
DEEPSEEK_API_KEY=${{DEEPSEEK_API_KEY}}

# Agentes Retell
AGENT_ID_PHONE=${{AGENT_ID_PHONE}}
AGENT_ID_WEB=${{AGENT_ID_WEB}}

# N8N configuración
N8N_WEBHOOK_URL=${{nexusvoz-n8n.RAILWAY_PUBLIC_DOMAIN}}
N8N_USER=admin
N8N_PASSWORD=${{N8N_PASSWORD}}

# Configuración general
LOG_LEVEL=INFO
TZ=America/Bogota

# URLs internas (Railway las manejará automáticamente)
AUTH_API_URL=http://nexusvoz-auth-api:8000